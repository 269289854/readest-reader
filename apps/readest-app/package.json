    "postcss-nested": "^7.0.2",
    "raw-loader": "^4.0.2",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.7.2",
    "vite": "^7.3.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.10"
  },
  "browserslist": [
    "chrome 92",
    "edge 92",
    "firefox 92",
    "safari 15.2"
  ],
  "description": "Standalone embeddable Readest Reader frontend",
  "license": "AGPL-3.0-only",
  "repository": "https://github.com/269289854/readest-reader"
}
