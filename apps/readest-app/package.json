    "react-i18next": "^15.2.0",
    "react-icons": "^5.4.0",
    "react-markdown": "^10.1.0",
    "react-responsive": "^10.0.0",
    "react-virtuoso": "^4.17.0",
    "react-window": "^1.8.11",
    "remark-gfm": "^4.0.1",
    "semver": "^7.7.1",
    "styled-jsx": "^5.1.7",
    "tailwind-merge": "^3.4.0",
    "tauri-plugin-device-info-api": "^1.0.1",
    "tinycolor2": "^1.6.0",
    "uuid": "^14.0.0",
    "virtua": "^0.49.1",
