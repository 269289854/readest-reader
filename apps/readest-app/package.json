{
  "name": "@readest/readest-app",
  "version": "0.12.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:reader": "dotenv -e .env.moke-reader -- next dev --turbo -p 3001",
    "build:reader": "pnpm setup-vendors && dotenv -e .env.moke-reader -- next build --webpack",
    "build:moke-reader": "pnpm build:reader",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src next.config.mjs vitest.config.mts",
    "format": "pnpm -w format",
    "format:check": "pnpm -w format:check",
    "prepare-public-vendor": "mkdirp ./public/vendor/pdfjs ./public/vendor/simplecc ./public/vendor/jieba",
    "copy-pdfjs-js": "cpx \"../../vendor/foliate-js/node_modules/pdfjs-dist/legacy/build/{pdf.worker.min.mjs,pdf.min.mjs,pdf.d.mts}\" ./public/vendor/pdfjs",
    "copy-pdfjs-wasm": "cpx \"../../vendor/foliate-js/node_modules/pdfjs-dist/wasm/*\" ./public/vendor/pdfjs",
    "copy-pdfjs-fonts": "cpx \"../../vendor/foliate-js/node_modules/pdfjs-dist/{cmaps,standard_fonts}/*\" ./public/vendor/pdfjs",
    "copy-flatten-pdfjs-annotation-layer-css": "npx postcss \"../../vendor/foliate-js/vendor/pdfjs/annotation_layer_builder.css\" --no-map -u postcss-nested > ./public/vendor/pdfjs/annotation_layer_builder.css",
    "copy-flatten-pdfjs-text-layer-css": "npx postcss \"../../vendor/foliate-js/vendor/pdfjs/text_layer_builder.css\" --no-map -u postcss-nested > ./public/vendor/pdfjs/text_layer_builder.css",
    "copy-flatten-pdfjs-css": "pnpm copy-flatten-pdfjs-annotation-layer-css && pnpm copy-flatten-pdfjs-text-layer-css",
    "copy-pdfjs": "pnpm copy-pdfjs-js && pnpm copy-pdfjs-wasm && pnpm copy-pdfjs-fonts && pnpm copy-flatten-pdfjs-css",
    "copy-simplecc": "cpx \"../../vendor/simplecc-wasm/dist/web/*\" ./public/vendor/simplecc",
    "copy-jieba": "cpx \"./node_modules/jieba-wasm/pkg/web/*\" ./public/vendor/jieba",
    "setup-pdfjs": "pnpm prepare-public-vendor && pnpm copy-pdfjs",
    "setup-simplecc": "pnpm prepare-public-vendor && pnpm copy-simplecc",
    "setup-jieba": "pnpm prepare-public-vendor && pnpm copy-jieba",
    "setup-vendors": "pnpm setup-pdfjs && pnpm setup-simplecc && pnpm setup-jieba"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.48",
    "@assistant-ui/react": "0.11.58",
    "@assistant-ui/react-markdown": "0.11.9",
    "@choochmeque/tauri-plugin-sharekit-api": "^0.3.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mozilla/readability": "^0.6.0",
    "@noble/hashes": "^1.8.0",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@readest/turso-database-common": "0.7.0-pre.3-readest.0",
    "@readest/turso-database-wasm": "0.7.0-pre.3-readest.0",
    "@supabase/supabase-js": "^2.76.1",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-biometric": "^2.3.2",
    "@tauri-apps/plugin-cli": "^2.4.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.0",
    "@tauri-apps/plugin-deep-link": "^2.4.7",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
